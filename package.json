{
  "name": "opensuperagent",
  "version": "0.1.1",
  "description": "OpenSuperAgent — persistent collaborative agent (Router + Workers)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "seed",
    "web/dist",
    "config.example.yaml"
  ],
  "bin": {
    "opensuperagent": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "prepack": "npm run build",
    "build": "npm run clean && tsc -p tsconfig.json && npm run build:web",
    "build:web": "npm --prefix web run build",
    "dev": "tsx src/cli.ts",
    "dev:web": "npm --prefix web run dev",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:integrations": "tsx --test test/adapters.test.ts test/feishu-websocket.test.ts test/delivery-concurrency.test.ts test/model-routing.test.ts test/settings.test.ts test/llm-validation.test.ts",
    "verify:live": "tsx scripts/verify-native-live.ts",
    "verify:catalog": "tsx scripts/verify-catalog-live.ts",
    "test:pizza": "tsx --test test/pizza-runtime.test.ts test/model-routing.test.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "yaml": "^2.7.1",
    "zod": "^4.6.7",
    "@tomsun28/pizza": "0.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "protobufjs": "^7.6.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "ws": "^8.22.1"
  }
}
