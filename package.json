{
  "name": "opensuperagent",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSuperAgent — persistent collaborative agent (Router + Workers)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "opensuperagent": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "npm --prefix web run build",
    "dev": "tsx src/cli.ts",
    "dev:web": "npm --prefix web run dev",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:integrations": "tsx --test test/adapters.test.ts test/feishu-websocket.test.ts test/delivery-concurrency.test.ts test/model-routing.test.ts test/settings.test.ts test/llm-validation.test.ts",
    "verify:live": "tsx scripts/verify-native-live.ts",
    "verify:catalog": "tsx scripts/verify-catalog-live.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "protobufjs": "^7.6.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "ws": "^8.22.1"
  },
  "optionalDependencies": {
    "@tomsun28/pizza": "file:../pizza"
  }
}
